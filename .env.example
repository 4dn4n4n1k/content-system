# Copy this file to .env and fill in your keys. Never commit .env.

# fal.ai API key — https://fal.ai/dashboard/keys  (format: key_id:key_secret)
FAL_KEY=

# Pexels API key (free) — https://www.pexels.com/api/
PEXELS_API_KEY=

# Cartesia TTS (default voiceover engine) — https://play.cartesia.ai/keys
CARTESIA_API_KEY=

# Optional alternatives (engine is set in config.yaml; edge-tts needs no key)
ELEVENLABS_API_KEY=
